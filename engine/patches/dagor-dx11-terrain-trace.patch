+#if DAGOR_DBGLEVEL > 0 && _TARGET_PC_WIN
+void ke_log_draw_state(RenderState &rs, const char *scope, int draw)
+{
+  PixelShader *ps = rs.nextPixelShader == BAD_FSHADER ? nullptr : g_pixel_shaders[rs.nextPixelShader].obj;
+  const char *name = ps && ps->shaderDebugName ? ps->shaderDebugName.get() : "<unnamed>";
+  ID3D11PixelShader *boundPs = nullptr;
+  dx_context->PSGetShader(&boundPs, nullptr, nullptr);
+  D3D11_VIEWPORT view{};
+  UINT nView = 1;
+  dx_context->RSGetViewports(&nView, &view);
+  ID3D11RenderTargetView *target = nullptr;
+  dx_context->OMGetRenderTargets(1, &target, nullptr);
+  D3D11_RENDER_TARGET_VIEW_DESC rtDesc{};
+  if (target)
+  {
+    target->GetDesc(&rtDesc);
+    target->Release();
+  }
+  ID3D11BlendState *blend = nullptr;
+  dx_context->OMGetBlendState(&blend, nullptr, nullptr);
+  D3D11_BLEND_DESC blendDesc{};
+  if (blend)
+  {
+    blend->GetDesc(&blendDesc);
+    blend->Release();
+  }
+  debug("[KE] DX11_DRAW scope=%s draw=%d ps=%s handle=%d ps_bound=%d ps_matches=%d "
+        "rtv0_dxgi=%u viewport=(%g,%g,%g,%g) write_mask0=0x%x",
+    scope, draw, name, int(rs.nextPixelShader), boundPs != nullptr, ps && ps->shader == boundPs && boundPs != nullptr,
+    unsigned(rtDesc.Format), view.TopLeftX, view.TopLeftY, view.Width, view.Height,
+    blend ? unsigned(blendDesc.RenderTarget[0].RenderTargetWriteMask) : 0xfu);
+  if (boundPs)
+    boundPs->Release();
+
+  ID3D11ShaderResourceView *views[D3D11_COMMONSHADER_INPUT_RESOURCE_SLOT_COUNT] = {};
+  dx_context->PSGetShaderResources(0, countof(views), views);
+  for (unsigned slot = 0; slot < countof(views); ++slot)
+  {
+    if (!views[slot])
+      continue;
+    D3D11_SHADER_RESOURCE_VIEW_DESC desc{};
+    views[slot]->GetDesc(&desc);
+    char label[256] = {};
+    UINT length = sizeof(label) - 1;
+    if (FAILED(views[slot]->GetPrivateData(WKPDID_D3DDebugObjectName, &length, label)))
+      label[0] = 0;
+    debug("[KE] DX11_SRV scope=%s draw=%d t%u name=%s dxgi=%u dimension=%d", scope, draw, slot,
+      label[0] ? label : "<unnamed>", unsigned(desc.Format), int(desc.ViewDimension));
+    views[slot]->Release();
+  }
+
+  if (!ps)
+    return;
+  static HMODULE compiler = LoadLibraryExW(L"d3dcompiler_47.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  const auto reflect = compiler ? reinterpret_cast<decltype(&D3DReflect)>(
+    reinterpret_cast<void *>(GetProcAddress(compiler, "D3DReflect"))) : nullptr;
+  if (!reflect)
+  {
+    debug("[KE] DX11_REFLECT scope=%s draw=%d status=compiler_missing", scope, draw);
+    return;
+  }
+  Tab<uint8_t> scratch(tmpmem);
+  uint32_t byteCount = 0;
+  const void *bytecode = ps->getBytecode(scratch, byteCount, false);
+  ID3D11ShaderReflection *reflection = nullptr;
+  const HRESULT hr = bytecode && byteCount ? reflect(bytecode, byteCount, __uuidof(ID3D11ShaderReflection),
+    reinterpret_cast<void **>(&reflection)) : E_FAIL;
+  if (FAILED(hr) || !reflection)
+  {
+    debug("[KE] DX11_REFLECT scope=%s draw=%d status=unavailable hr=0x%08x", scope, draw, unsigned(hr));
+    return;
+  }
+  D3D11_SHADER_DESC shaderDesc{};
+  if (SUCCEEDED(reflection->GetDesc(&shaderDesc)))
+  {
+    for (UINT i = 0; i < shaderDesc.OutputParameters; ++i)
+    {
+      D3D11_SIGNATURE_PARAMETER_DESC output{};
+      if (SUCCEEDED(reflection->GetOutputParameterDesc(i, &output)))
+        debug("[KE] DX11_PS_OUTPUT scope=%s draw=%d semantic=%s%u register=%u component_type=%d mask=0x%x", scope, draw,
+          output.SemanticName, output.SemanticIndex, output.Register, int(output.ComponentType), unsigned(output.Mask));
+    }
+    for (UINT i = 0; i < shaderDesc.BoundResources; ++i)
+    {
+      D3D11_SHADER_INPUT_BIND_DESC resource{};
+      if (SUCCEEDED(reflection->GetResourceBindingDesc(i, &resource)) && resource.Type == D3D_SIT_TEXTURE)
+        debug("[KE] DX11_PS_INPUT scope=%s draw=%d name=%s t%u count=%u return_type=%d", scope, draw,
+          resource.Name, resource.BindPoint, resource.BindCount, int(resource.ReturnType));
+    }
+  }
+  reflection->Release();
+}
+#endif
