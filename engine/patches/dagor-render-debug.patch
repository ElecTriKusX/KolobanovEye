+        const unsigned w = depth.getWidthInElems(), h = depth.getHeightInElems();
+        total = w * h;
+        Tab<TexPixel32> mask(tmpmem);
+        mask.resize(total);
+        for (unsigned row = 0; row < h; ++row)
+        {
+          const auto *values = reinterpret_cast<const float *>(
+            reinterpret_cast<const char *>(depth.get()) + row * depth.getByteStride());
+          for (unsigned col = 0; col < w; ++col)
+          {
+            // The main G-buffer uses reverse Z and clears depth to zero.
+            const bool drawn = values[col] > 0.f && values[col] <= 1.f;
+            mask[row * w + col].u = drawn ? 0xffffffffu : 0xff000000u;
+            covered += drawn;
+          }
+        }
+        depthSaved = save_png32(String(0, "%s/static-depth-mask.png", dir), mask.data(), w, h, w * sizeof(TexPixel32),
