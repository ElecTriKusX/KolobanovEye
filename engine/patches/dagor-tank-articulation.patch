 // The 12 edges of the transformed local AABB. Clip to both depth planes
 // before dividing by z, then clip the resulting rectangle to the image.
+// Carry the full neutral envelope through each rigid joint displacement.
+void include_transformed_bounds(BBox3 &target, const BBox3 &source, const TMatrix &transform)
+{
+  for (int corner = 0; corner < 8; ++corner)
+    target += transform * Point3(source[(corner & 1) != 0].x, source[(corner & 2) != 0].y, source[(corner & 4) != 0].z);
+}
+
+TMatrix rotation_about_pivot(const Point3 &axis, const Point3 &pivot, float degrees)
+{
+  TMatrix rotation = makeTM(axis, degrees * DEG_TO_RAD);
+  rotation.setcol(3, pivot - rotation * pivot);
+  return rotation;
+}
