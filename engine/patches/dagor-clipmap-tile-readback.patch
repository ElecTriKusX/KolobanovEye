+// Compare one terrain tile in the render buffer and the cache without mapping either live texture.
+static void report_clipmap_tile_rgb(const char *stage, Texture *source, int x, int y, int size)
+{
+  TextureInfo info;
+  if (!source || !source->getinfo(info) || x < 0 || y < 0 || size <= 0 || x + size > info.w || y + size > info.h)
+  {
+    debug("[KE] CLIPMAP_TILE %s status=invalid_region", stage);
+    return;
+  }
+
+  const unsigned format = info.cflg & TEXFMT_MASK;
+  const bool bc3 = format == TEXFMT_DXT5;
+  const bool rgba8 = format == TEXFMT_A8R8G8B8 || format == TEXFMT_A8B8G8R8;
+  if (!(rgba8 || (bc3 && ((x | y | size) & 3) == 0)))
+  {
+    debug("[KE] CLIPMAP_TILE %s status=unsupported_format format=0x%08x", stage, format);
+    return;
+  }
+
+  SCOPE_RENDER_TARGET;
+  d3d::set_render_target({}, DepthAccess::RW, {});
+  UniqueTex staging = dag::create_tex(nullptr, size, size, format | TEXCF_SYSMEM | TEXCF_UPDATE_DESTINATION, 1,
+    "ke_clipmap_tile_readback", RESTAG_LAND);
+  Texture *stagingTex = staging.getTex2D();
+  if (!stagingTex || !d3d::update_sub_region(source, 0, x, y, 0, size, size, 1, stagingTex, 0, 0, 0, 0))
+  {
+    debug("[KE] CLIPMAP_TILE %s status=copy_failed format=0x%08x", stage, format);
+    return;
+  }
+
+  void *pixels = nullptr;
+  int stride = 0;
+  if (!stagingTex->lockimg(&pixels, stride, 0, TEXLOCK_READ | TEXLOCK_DONOTUPDATE))
+  {
+    debug("[KE] CLIPMAP_TILE %s status=lock_failed format=0x%08x", stage, format);
+    return;
+  }
+
+  int nonBlack = 0;
+  if (pixels && stride >= size * 4)
+  {
+    const int rows = bc3 ? size / 4 : size;
+    const int cols = bc3 ? size / 4 : size;
+    for (int row = 0; row < rows; ++row)
+    {
+      const auto *line = static_cast<const uint8_t *>(pixels) + row * stride;
+      for (int col = 0; col < cols; ++col)
+      {
+        if (bc3)
+        {
+          // BC3 uses four RGB colors regardless of endpoint order. Alpha occupies the first eight bytes.
+          const auto *colors = line + col * 16 + 8;
+          const bool color0 = (colors[0] | colors[1]) != 0;
+          const bool color1 = (colors[2] | colors[3]) != 0;
+          const bool nonBlackColor[] = {color0, color1, color0 || color1, color0 || color1};
+          for (int indexByte = 4; indexByte < 8; ++indexByte)
+            for (int bit = 0; bit < 8; bit += 2)
+              nonBlack += nonBlackColor[(colors[indexByte] >> bit) & 3];
+        }
+        else
+        {
+          const auto *rgb = line + col * 4;
+          nonBlack += (rgb[0] | rgb[1] | rgb[2]) != 0;
+        }
+      }
+    }
+  }
+  else
+    nonBlack = -1;
+  stagingTex->unlockimg();
+  debug("[KE] CLIPMAP_TILE %s status=%s format=0x%08x nonblack=%d pixels=%d", stage, nonBlack >= 0 ? "ok" : "bad_pitch",
+    format, nonBlack, size * size);
+}
