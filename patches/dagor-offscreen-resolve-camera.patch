+  void dumpResolveDepth(const char *dir, Texture *texture)
+  {
+    TextureInfo info{};
+    if (!texture || !texture->getinfo(info) || (info.cflg & TEXFMT_MASK) != TEXFMT_DEPTH32)
+    {
+      debug("[KE] PASS_CAPTURE name=resolve-input-depth status=unsupported");
+      return;
+    }
+    const auto depth = lock_texture<const float>(texture, 0, TEXLOCK_READ);
+    if (!depth)
+    {
+      debug("[KE] PASS_CAPTURE name=resolve-input-depth status=lock_failed");
+      return;
+    }
+
+    const int width = depth.getWidthInElems();
+    const int height = depth.getHeightInElems();
+    Tab<TexPixel32> pixels(tmpmem);
+    pixels.resize(width * height);
+    for (int y = 0; y < height; ++y)
+    {
+      const auto *row = reinterpret_cast<const float *>(reinterpret_cast<const char *>(depth.get()) + y * depth.getByteStride());
+      for (int x = 0; x < width; ++x)
+      {
+        const float z = row[x];
+        TexPixel32 &pixel = pixels[y * width + x];
+        pixel.a = 255;
+        if (!std::isfinite(z) || z < 0.f || z > 1.f)
+        {
+          pixel.r = pixel.b = 255;
+          pixel.g = 0;
+          continue;
+        }
+        // Logarithmic preview of reverse-Z: nearer surfaces are brighter, clear depth is black.
+        const float gray = z > 0.f ? min(1.f, max(0.f, 1.f + std::log2(z) / 24.f)) : 0.f;
+        pixel.r = pixel.g = pixel.b = static_cast<unsigned char>(gray * 255.f + 0.5f);
+      }
+    }
+    const bool saved = save_png32(String(0, "%s/resolve-input-depth.png", dir), pixels.data(), width, height,
+      width * sizeof(TexPixel32), nullptr, 0, false);
+    debug("[KE] PASS_CAPTURE name=resolve-input-depth status=%s reverse_z_log=1", saved ? "ok" : "save_failed");
+  }
+
