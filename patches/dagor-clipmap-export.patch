+// Optional export of rendered clipmap tiles before compression. The caller creates this output directory.
+static void ke_export_tile(Texture *source, int slot, int size, const BBox2 &region, int mip, int border)
+{
+  static unsigned count = 0;
+  if (count >= 4096 || !source || size <= 0) return;
+  TextureInfo info;
+  if (!source->getinfo(info)) return;
+  const unsigned format = info.cflg & TEXFMT_MASK;
+  if (format != TEXFMT_A8R8G8B8 && format != TEXFMT_A8B8G8R8)
+  {
+    debug("[KE] TILE_EXPORT unsupported_format=%u", format);
+    return;
+  }
+  SCOPE_RENDER_TARGET;
+  d3d::set_render_target({}, DepthAccess::RW, {});
+  UniqueTex staging = dag::create_tex(nullptr, size, size, format | TEXCF_SYSMEM | TEXCF_UPDATE_DESTINATION, 1,
+    "ke_export_tile", RESTAG_LAND);
+  Texture *tex = staging.getTex2D();
+  if (!tex || !d3d::update_sub_region(source, 0, slot * size, 0, 0, size, size, 1, tex, 0, 0, 0, 0)) return;
+  void *pixels = nullptr;
+  int stride = 0;
+  if (!tex->lockimg(&pixels, stride, 0, TEXLOCK_READ | TEXLOCK_DONOTUPDATE)) return;
+  if (!pixels || stride < size * 4) { tex->unlockimg(); return; }
+  const char *dir = dgs_get_argv("ke-collect-clipmap");
+  if (!dir || !*dir) { tex->unlockimg(); return; }
+  char path[512];
+  if (snprintf(path, sizeof(path), "%s/tile-%06u.ppm", dir, count) >= int(sizeof(path))) { tex->unlockimg(); return; }
+  FILE *out = fopen(path, "wb");
+  bool ok = out != nullptr;
+  if (out)
+  {
+    if (fprintf(out, "P6\n%d %d\n255\n", size, size) < 0) ok = false;
+    for (int y = 0; y < size && ok; ++y)
+    {
+      const unsigned char *row = static_cast<const unsigned char *>(pixels) + y * stride;
+      for (int x = 0; x < size; ++x)
+      {
+        const unsigned char *p = row + 4 * x;
+        const unsigned char rgb[3] = {p[format == TEXFMT_A8R8G8B8 ? 2 : 0], p[1], p[format == TEXFMT_A8R8G8B8 ? 0 : 2]};
+        if (fwrite(rgb, 1, 3, out) != 3) { ok = false; break; }
+      }
+    }
+    if (fclose(out) != 0) ok = false;
+  }
+  tex->unlockimg();
+  if (ok)
+  {
+    char indexPath[512];
+    snprintf(indexPath, sizeof(indexPath), "%s/tiles.csv", dir);
+    FILE *index = fopen(indexPath, "ab");
+    if (index)
+    {
+      fprintf(index, "tile-%06u.ppm,%.9g,%.9g,%.9g,%.9g,%d,%d,%d\n", count,
+        region[0].x, region[0].y, region[1].x, region[1].y, mip, size, border);
+      fclose(index);
+      ++count;
+    }
+  }
+  else debug("[KE] TILE_EXPORT write_failed");
+}
