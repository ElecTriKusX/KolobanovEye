diff --git a/prog/gameLibs/landMesh/lastClip.cpp b/prog/gameLibs/landMesh/lastClip.cpp
--- a/prog/gameLibs/landMesh/lastClip.cpp
+++ b/prog/gameLibs/landMesh/lastClip.cpp
@@ -377,6 +377,31 @@
 void render_last_clip_to_tex(Texture *tex, LandMeshData &data, const Point3 &view_pos)
 {
   G_ASSERT(data.lmeshMgr && data.lmeshRenderer);
   FixedClipRenderStateGuard renderStateGuard(data.lmeshMgr->getHmapHandler());
   fixed_clip_plain_render(tex, data, view_pos);
 }
+
+void render_last_clip_region_to_tex(Texture *tex, const BBox3 &region, LandMeshData &data, const Point3 &view_pos)
+{
+  G_ASSERT(tex && data.lmeshMgr && data.lmeshRenderer);
+  G_ASSERT(data.texture_size > 0);
+  FixedClipRenderStateGuard renderStateGuard(data.lmeshMgr->getHmapHandler());
+  d3d::GpuAutoLock acquire;
+  d3d::setwire(0);
+  {
+    SCOPE_RENDER_TARGET;
+    d3d::set_render_target({}, DepthAccess::RW, {{tex, 0, 0}});
+    d3d::clearview(CLEAR_TARGET, 0x00000000, 1.0f, 0);
+    for (int y = 0; y < data.texture_size; y += 128)
+    {
+      const int lines = min(128, data.texture_size - y);
+      d3d::driver_command(Drv3dCommand::D3D_FLUSH);
+      d3d::setview(0, y, data.texture_size - 1, lines, 0, 1);
+      const float z0 = lerp(region[0].z, region[1].z, float(y) / data.texture_size);
+      const float z1 = lerp(region[0].z, region[1].z, float(y + lines) / data.texture_size);
+      const BBox3 part(Point3(region[0].x, region[0].y, z0), Point3(region[1].x, region[1].y, z1));
+      render_last_clip_in_box(part, Point2(0.f, 0.f), view_pos, data);
+    }
+  }
+  d3d::resource_barrier({tex, RB_RO_SRV | RB_STAGE_PIXEL, 0, 0});
+}
