   prepare_fixed_clip(last_clip, last_clip_sampler, data, false, ::grs_cur_view.pos);
+  // The regular full-landscape clip is still required for RGB rendering. The user
+  // overview is a separate uncompressed render target covering the tank square.
+  if (const char *output = dgs_get_argv("ke-tank-map-output"); output && *output && !dd_file_exist(output))
+  {
+    const bool haveBounds = levelSettingsBlk.paramExists("tankMapCoord0") && levelSettingsBlk.paramExists("tankMapCoord1");
+    const Point2 mn = levelSettingsBlk.getPoint2("tankMapCoord0", Point2(0.f, 0.f));
+    const Point2 mx = levelSettingsBlk.getPoint2("tankMapCoord1", Point2(0.f, 0.f));
+    if (haveBounds && std::isfinite(mn.x) && std::isfinite(mn.y) && std::isfinite(mx.x) && std::isfinite(mx.y) &&
+        mn.x < mx.x && mn.y < mx.y)
+    {
+      int size = 1024;
+      if (const char *requested = dgs_get_argv("ke-tank-map-size"); requested && *requested)
+        size = atoi(requested);
+      const int maxSize = min(d3d::get_driver_desc().maxtexw, d3d::get_driver_desc().maxtexh);
+      if (size >= 256 && size <= 4096 && size <= maxSize && (size & (size - 1)) == 0)
+      {
+        const float side = min(mx.x - mn.x, mx.y - mn.y);
+        const float cx = (mn.x + mx.x) * 0.5f, cz = (mn.y + mx.y) * 0.5f;
+        BBox3 square = lmeshMgr->getBBox();
+        square[0].x = cx - side * 0.5f;
+        square[1].x = cx + side * 0.5f;
+        square[0].z = cz - side * 0.5f;
+        square[1].z = cz + side * 0.5f;
+        auto target = dag::create_tex(nullptr, size, size,
+          TEXFMT_A8R8G8B8 | TEXCF_RTARGET | TEXCF_SRGBWRITE | TEXCF_SRGBREAD, 1, "ke_tank_map_rt", RESTAG_LAND);
+        if (target.getTex2D())
+        {
+          LandMeshData region = data;
+          region.texture_size = size;
+          render_last_clip_region_to_tex(target.getTex2D(), square, region, ::grs_cur_view.pos);
+          const auto pixels = lock_texture<const TexPixel32>(target.getTex2D(), 0, TEXLOCK_READ);
+          const bool saved = pixels && save_png32(output, reinterpret_cast<const TexPixel32 *>(pixels.get()),
+            pixels.getWidthInElems(), pixels.getHeightInElems(), pixels.getByteStride(), nullptr, 0, false);
+          debug("[KE] TANK_MAP_RENDER saved=%d resolution=%d x=%.3f..%.3f z=%.3f..%.3f",
+            saved ? 1 : 0, size, square[0].x, square[1].x, square[0].z, square[1].z);
+        }
+        else
+          debug("[KE] TANK_MAP_RENDER cannot_allocate_render_target resolution=%d", size);
+      }
+      else
+        debug("[KE] TANK_MAP_RENDER invalid_resolution=%d max=%d", size, maxSize);
+    }
+    else
+      debug("[KE] TANK_MAP_RENDER missing_or_invalid_tankMapCoord0_1");
+  }
   lmeshRenderer->setLMeshRenderingMode(oldm);
